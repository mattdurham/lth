+// DeleteChunkSnapshotsAheadOf deletes all chunk snapshot directories (including
+// .tmp ones) whose WAL segment index is strictly greater than segmentIdx. This
+// is used to remove stale snapshots that belong to a previous WAL epoch (e.g.
+// after the WAL was reset) while preserving any snapshots that are valid for
+// the current WAL range.
+func DeleteChunkSnapshotsAheadOf(dir string, segmentIdx int) error {
+	files, err := os.ReadDir(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		return err
+	}
+
+	errs := tsdb_errors.NewMulti()
+	for _, fi := range files {
+		if !strings.HasPrefix(fi.Name(), chunkSnapshotPrefix) {
+			continue
+		}
+
+		name := fi.Name()[len(chunkSnapshotPrefix):]
+		name = strings.TrimSuffix(name, ".tmp")
+		splits := strings.Split(name, ".")
+		if len(splits) != 2 {
+			continue
+		}
+
+		idx, err := strconv.Atoi(splits[0])
+		if err != nil {
+			continue
+		}
+
+		if idx > segmentIdx {
+			if err := os.RemoveAll(filepath.Join(dir, fi.Name())); err != nil {
+				errs.Add(err)
+			}
+		}
+	}
+	return errs.Err()
+}
