diff --git a/internal/configs/configschema/marks.go b/internal/configs/configschema/marks.go
index 45729da..c06828d 100644
--- a/internal/configs/configschema/marks.go
+++ b/internal/configs/configschema/marks.go
@@ -62,7 +62,7 @@ func (b *Block) SensitivePaths(val cty.Value, basePath cty.Path) []cty.Path {
 		switch blockS.Nesting {
 		case NestingSingle, NestingGroup:
 			ret = append(ret, blockS.Block.SensitivePaths(blockV, blockPath)...)
-		case NestingList, NestingMap, NestingSet:
+		case NestingList, NestingMap:
 			blockV, _ = blockV.Unmark() // peel off one level of marking so we can iterate
 			for it := blockV.ElementIterator(); it.Next(); {
 				idx, blockEV := it.Element()
@@ -72,6 +72,20 @@ func (b *Block) SensitivePaths(val cty.Value, basePath cty.Path) []cty.Path {
 				morePaths := blockS.Block.SensitivePaths(blockEV, blockInstancePath)
 				ret = append(ret, morePaths...)
 			}
+		case NestingSet:
+			// For set blocks we cannot mark individual element sub-attributes
+			// using cty.IndexPath because set elements are indexed by their
+			// value hash. Marking a sub-attribute within a set element changes
+			// the element's hash, so cty ends up marking the entire set instead.
+			// This produces a path that cannot be stably round-tripped through
+			// state serialization, causing a spurious diff on every subsequent
+			// plan. Instead, when the set is non-empty we mark the whole set
+			// block path, which is consistent with what state serialization
+			// actually stores for a set that contains sensitive attributes.
+			blockV, _ = blockV.Unmark() // peel off one level of marking so we can check length
+			if blockV.IsKnown() && !blockV.IsNull() && blockV.LengthInt() > 0 {
+				ret = append(ret, blockPath)
+			}
 		default:
 			panic(fmt.Sprintf("unsupported nesting mode %s", blockS.Nesting))
 		}
diff --git a/internal/configs/configschema/marks_test.go b/internal/configs/configschema/marks_test.go
index 7aa2562..e829d49 100644
--- a/internal/configs/configschema/marks_test.go
+++ b/internal/configs/configschema/marks_test.go
@@ -224,3 +224,79 @@ func TestBlockValueMarks(t *testing.T) {
 		})
 	}
 }
+
+// TestBlockValueMarksSetBlock verifies that sensitive attributes inside a set
+// nested block cause the whole set to be marked (not per-element paths), so
+// that the sensitive path stored in state matches what SensitivePaths computes
+// on reload and no spurious diff is produced.
+func TestBlockValueMarksSetBlock(t *testing.T) {
+	schema := &Block{
+		BlockTypes: map[string]*NestedBlock{
+			"set_nested_block": {
+				Nesting: NestingSet,
+				Block: Block{
+					Attributes: map[string]*Attribute{
+						"unsensitive": {
+							Type:     cty.String,
+							Optional: true,
+						},
+						"sensitive_str": {
+							Type:      cty.String,
+							Sensitive: true,
+						},
+					},
+				},
+			},
+		},
+	}
+
+	setElemType := cty.Object(map[string]cty.Type{
+		"unsensitive":   cty.String,
+		"sensitive_str": cty.String,
+	})
+
+	testCases := map[string]struct {
+		given  cty.Value
+		expect cty.Value
+	}{
+		"empty set block produces no paths": {
+			given: cty.ObjectVal(map[string]cty.Value{
+				"set_nested_block": cty.SetValEmpty(setElemType),
+			}),
+			expect: cty.ObjectVal(map[string]cty.Value{
+				"set_nested_block": cty.SetValEmpty(setElemType),
+			}),
+		},
+		"non-empty set block marks entire set": {
+			given: cty.ObjectVal(map[string]cty.Value{
+				"set_nested_block": cty.SetVal([]cty.Value{
+					cty.ObjectVal(map[string]cty.Value{
+						"unsensitive":   cty.StringVal("public"),
+						"sensitive_str": cty.StringVal("secret"),
+					}),
+				}),
+			}),
+			// The entire set is marked, not individual element sub-attributes.
+			// This is consistent with how state serialization encodes the mark
+			// (as a single get_attr step), preventing spurious diffs on reload.
+			expect: cty.ObjectVal(map[string]cty.Value{
+				"set_nested_block": cty.SetVal([]cty.Value{
+					cty.ObjectVal(map[string]cty.Value{
+						"unsensitive":   cty.StringVal("public"),
+						"sensitive_str": cty.StringVal("secret"),
+					}),
+				}).Mark(marks.Sensitive),
+			}),
+		},
+	}
+
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			sensitivePaths := schema.SensitivePaths(tc.given, nil)
+			got := marks.MarkPaths(tc.given, marks.Sensitive, sensitivePaths)
+			if !tc.expect.RawEquals(got) {
+				t.Fatalf("\nexpected: %#v\ngot:      %#v\n", tc.expect, got)
+			}
+		})
+	}
+}
