+// CreateTestContextOnly returns a fresh context based on the engine for testing purposes.
+// Unlike CreateTestContext, the engine is provided by the caller so that routes registered
+// on it (and their param counts) are reflected in the context's pre-allocated params slice,
+// preventing a panic when HandleContext is called on a route with URL parameters.
+func CreateTestContextOnly(w http.ResponseWriter, r *Engine) (c *Context) {
+	c = r.allocateContext(r.maxParams)
 	c.reset()
 	c.writermem.reset(w)
 	return
