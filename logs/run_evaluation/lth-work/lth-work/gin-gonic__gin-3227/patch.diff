+
+func TestRouteRedirectFixedPathWithTrailingSlash(t *testing.T) {
+	router := New()
+	router.RedirectFixedPath = true
+	router.RedirectTrailingSlash = true
+
+	router.POST("/Path4/", func(c *Context) {})
+
+	// Both RedirectFixedPath and RedirectTrailingSlash enabled: redirect is allowed.
+	w := PerformRequest(router, http.MethodPost, "/path4")
 	assert.Equal(t, "/Path4/", w.Header().Get("Location"))
 	assert.Equal(t, http.StatusTemporaryRedirect, w.Code)
 }
 
+func TestRouteRedirectFixedPathDoesNotRedirectTrailingSlash(t *testing.T) {
+	// Regression test: RedirectFixedPath must not redirect trailing slashes
+	// when RedirectTrailingSlash is false.
+	router := New()
+	router.RedirectTrailingSlash = false
+	router.RedirectFixedPath = true
+
+	router.GET("/ping", func(c *Context) {
+		c.String(http.StatusOK, "pong")
+	})
+
+	w := PerformRequest(router, http.MethodGet, "/ping/")
+	assert.Equal(t, http.StatusNotFound, w.Code)
+	assert.Equal(t, "", w.Header().Get("Location"))
+}
