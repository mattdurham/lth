@@ -0,0 +1,33 @@
+// Copyright 2019 Gin Core Team. All rights reserved.
+// Use of this source code is governed by a MIT style
+// license that can be found in the LICENSE file.
+
+package binding
+
+import (
+	"net/http"
+	"net/textproto"
+	"reflect"
+)
+
+type headerBinding struct{}
+
+func (headerBinding) Name() string {
+	return "header"
+}
+
+func (headerBinding) Bind(req *http.Request, obj interface{}) error {
+	if err := mapHeader(obj, req.Header); err != nil {
+		return err
+	}
+	return validate(obj)
+}
+
+func mapHeader(ptr interface{}, h map[string][]string) error {
+	return mappingByPtr(ptr, headerSource(h), "header")
+}
+
+type headerSource map[string][]string
+
+var _ setter = headerSource{}
+
+func (hs headerSource) TrySet(value reflect.Value, field reflect.StructField, tagValue string, opt setOptions) (bool, error) {
+	return setByForm(value, field, hs, textproto.CanonicalMIMEHeaderKey(tagValue), opt)
+}
diff --git a/binding/header_test.go b/binding/header_test.go
new file mode 100644
index 0000000..d89c5d4
--- /dev/null
+++ b/binding/header_test.go
@@ -0,0 +1,62 @@
+// Copyright 2019 Gin Core Team. All rights reserved.
+// Use of this source code is governed by a MIT style
+// license that can be found in the LICENSE file.
+
+package binding
+
+import (
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestHeaderBindingName(t *testing.T) {
+	assert.Equal(t, "header", Header.Name())
+}
+
+func TestHeaderBinding(t *testing.T) {
+	var obj struct {
+		Rate   int    `header:"Rate"`
+		Domain string `header:"Domain"`
+	}
+
+	req, _ := http.NewRequest("GET", "/", nil)
+	req.Header.Add("Rate", "8")
+	req.Header.Add("Domain", "music")
+
+	assert.NoError(t, Header.Bind(req, &obj))
+	assert.Equal(t, 8, obj.Rate)
+	assert.Equal(t, "music", obj.Domain)
+}
+
+func TestHeaderBindingTextProto(t *testing.T) {
+	// HTTP headers are stored in canonical form; tag values are canonicalized
+	// via textproto.CanonicalMIMEHeaderKey so "content-type" matches "Content-Type".
+	var obj struct {
+		ContentType string `header:"content-type"`
+	}
+
+	req, _ := http.NewRequest("GET", "/", nil)
+	req.Header.Set("Content-Type", "application/json")
+
+	assert.NoError(t, Header.Bind(req, &obj))
+	assert.Equal(t, "application/json", obj.ContentType)
+}
+
+func TestHeaderBindingInvalidType(t *testing.T) {
+	var obj struct {
+		Rating float32 `header:"Rating"`
+	}
+
+	req, _ := http.NewRequest("GET", "/", nil)
+	req.Header.Add("Rating", "not-a-float")
+
+	assert.Error(t, Header.Bind(req, &obj))
+}
+
+func TestHeaderBindingMissingHeader(t *testing.T) {
+	var obj struct {
+		Domain string `header:"Domain"`
+	}
+
+	req, _ := http.NewRequest("GET", "/", nil)
+	// Domain header not set — field stays zero value, no error
+	assert.NoError(t, Header.Bind(req, &obj))
+	assert.Equal(t, "", obj.Domain)
+}
