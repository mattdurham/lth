+package terraform
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/providers"
+)
+
+// TestContext2Validate_importUndefinedLocal reproduces the bug where
+// terraform validate does not catch an undefined local value in an import
+// block's id field.
+func TestContext2Validate_importUndefinedLocal(t *testing.T) {
+	p := simpleMockProvider()
+	ctx := testContext2(t, &ContextOpts{
+		Providers: map[addrs.Provider]providers.Factory{
+			addrs.NewDefaultProvider("test"): testProviderFuncFixed(p),
+		},
+	})
+
+	m := testModuleInline(t, map[string]string{
+		"main.tf": `
+resource "test_object" "a" {
+}
+
+import {
+  to = test_object.a
+  id = local.something_not_defined
+}
+`,
+	})
+
+	diags := ctx.Validate(m, &ValidateOpts{})
+	if !diags.HasErrors() {
+		t.Fatal("expected error for undefined local in import id, but got none")
+	}
+}
+
