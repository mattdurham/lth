+func TestFormMultipartBindingBindFileNotPresent(t *testing.T) {
+	var s struct {
+		Name    string                `form:"name" binding:"required"`
+		Email   string                `form:"email" binding:"required"`
+		FilePtr *multipart.FileHeader `form:"file"`
+	}
+
+	req := createRequestMultipartFilesAndFields(t,
+		map[string]string{"name": "foo", "email": "foo@example.com"},
+	)
+	err := FormMultipart.Bind(req, &s)
+	require.NoError(t, err)
+	assert.Equal(t, "foo", s.Name)
+	assert.Equal(t, "foo@example.com", s.Email)
+	assert.Nil(t, s.FilePtr)
+}
