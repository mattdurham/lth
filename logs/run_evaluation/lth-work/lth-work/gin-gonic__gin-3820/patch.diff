@@ -29,6 +29,13 @@ func (r *multipartRequest) TrySet(value reflect.Value, field reflect.StructField
 		return setByMultipartFormFile(value, field, files)
 	}
 
+	// When the target type is multipart.FileHeader and no file was uploaded, leave the
+	// field unset rather than falling through to setByForm, which would attempt JSON
+	// parsing of an empty string and return "unexpected end of JSON input".
+	if _, ok := value.Interface().(multipart.FileHeader); ok {
+		return false, nil
+	}
+
 	return setByForm(value, field, r.MultipartForm.Value, key, opt)
 }
 
