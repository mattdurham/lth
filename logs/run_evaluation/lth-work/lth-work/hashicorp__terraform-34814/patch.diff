+// TestDisconnectClosesSSHClient verifies that Disconnect sends SSH_MSG_DISCONNECT
+// by closing the ssh.Client before the raw TCP conn. Without this, sockets stay
+// in ESTABLISHED state because the OS never receives FIN packets.
+func TestDisconnectClosesSSHClient(t *testing.T) {
+	address := newMockLineServer(t, nil, testClientPublicKey)
+	parts := strings.Split(address, ":")
+
+	v := cty.ObjectVal(map[string]cty.Value{
+		"type":     cty.StringVal("ssh"),
+		"user":     cty.StringVal("user"),
+		"password": cty.StringVal("pass"),
+		"host":     cty.StringVal(parts[0]),
+		"port":     cty.StringVal(parts[1]),
+		"timeout":  cty.StringVal("30s"),
+	})
+
+	c, err := New(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err := c.Connect(nil); err != nil {
+		t.Fatal(err)
+	}
+
+	if c.client == nil {
+		t.Fatal("expected client to be non-nil after Connect")
+	}
+
+	// Hold a reference to the client so we can verify it was closed.
+	sshClient := c.client
+
+	if err := c.Disconnect(); err != nil {
+		t.Fatal(err)
+	}
+
+	if c.client != nil {
+		t.Error("expected c.client to be nil after Disconnect")
+	}
+	if c.conn != nil {
+		t.Error("expected c.conn to be nil after Disconnect")
+	}
+
+	// The SSH client must be closed: any operation on it should fail.
+	// If Disconnect only closed the raw TCP conn without calling client.Close(),
+	// this might succeed (the client object still looks alive), which is the bug.
+	_, err = sshClient.NewSession()
+	if err == nil {
+		t.Fatal("expected NewSession to fail on a disconnected client; SSH client was not closed by Disconnect")
+	}
+}
