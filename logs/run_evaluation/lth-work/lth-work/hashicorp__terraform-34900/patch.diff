diff --git a/internal/configs/configschema/marks_test.go b/internal/configs/configschema/marks_test.go
index 7aa2562..2c11de9 100644
--- a/internal/configs/configschema/marks_test.go
+++ b/internal/configs/configschema/marks_test.go
@@ -10,6 +10,108 @@ import (
 	"github.com/zclconf/go-cty/cty"
 )
 
+// TestBlockSensitivePathsNestingSet verifies that SensitivePaths returns a
+// set-level path for NestingSet blocks rather than per-element paths.
+// Per-element paths are unstable because set element identity (hash) is
+// derived from content, and applying marks changes that hash.
+func TestBlockSensitivePathsNestingSet(t *testing.T) {
+	schema := &Block{
+		BlockTypes: map[string]*NestedBlock{
+			"set_block": {
+				Nesting: NestingSet,
+				Block: Block{
+					Attributes: map[string]*Attribute{
+						"normal": {
+							Type:     cty.String,
+							Optional: true,
+						},
+						"sensitive": {
+							Type:      cty.String,
+							Sensitive: true,
+						},
+					},
+				},
+			},
+		},
+	}
+
+	setBlockElemType := cty.Object(map[string]cty.Type{
+		"normal":    cty.String,
+		"sensitive": cty.String,
+	})
+
+	t.Run("non-empty set returns set-level path", func(t *testing.T) {
+		val := cty.ObjectVal(map[string]cty.Value{
+			"set_block": cty.SetVal([]cty.Value{
+				cty.ObjectVal(map[string]cty.Value{
+					"normal":    cty.StringVal("hello"),
+					"sensitive": cty.StringVal("secret"),
+				}),
+			}),
+		})
+
+		paths := schema.SensitivePaths(val, nil)
+
+		expected := cty.NewPathSet(cty.GetAttrPath("set_block"))
+		got := cty.NewPathSet(paths...)
+		if !expected.Equal(got) {
+			t.Fatalf("expected set-level path\nexpected: %#v\ngot:      %#v", expected, got)
+		}
+	})
+
+	t.Run("empty set returns no paths", func(t *testing.T) {
+		val := cty.ObjectVal(map[string]cty.Value{
+			"set_block": cty.SetValEmpty(setBlockElemType),
+		})
+
+		paths := schema.SensitivePaths(val, nil)
+		if len(paths) != 0 {
+			t.Fatalf("expected no paths for empty set, got: %#v", paths)
+		}
+	})
+
+	t.Run("null set returns no paths", func(t *testing.T) {
+		val := cty.ObjectVal(map[string]cty.Value{
+			"set_block": cty.NullVal(cty.Set(setBlockElemType)),
+		})
+
+		paths := schema.SensitivePaths(val, nil)
+		if len(paths) != 0 {
+			t.Fatalf("expected no paths for null set, got: %#v", paths)
+		}
+	})
+
+	t.Run("path is stable across mark-unmark round trip", func(t *testing.T) {
+		// This is the core regression test: applying the paths returned by
+		// SensitivePaths and then calling SensitivePaths again must return
+		// the same paths (no spurious diff on second apply).
+		val := cty.ObjectVal(map[string]cty.Value{
+			"set_block": cty.SetVal([]cty.Value{
+				cty.ObjectVal(map[string]cty.Value{
+					"normal":    cty.StringVal("hello"),
+					"sensitive": cty.StringVal("secret"),
+				}),
+			}),
+		})
+
+		// Simulate first apply: compute paths, mark value, store in state.
+		firstPaths := schema.SensitivePaths(val, nil)
+		marked := marks.MarkPaths(val, marks.Sensitive, firstPaths)
+
+		// Simulate second apply: unmark (as state loading does), re-apply
+		// priorMarks, then recompute SensitivePaths.
+		unmarked, priorPathMarks := marked.UnmarkDeepWithPaths()
+		remarked := unmarked.MarkWithPaths(priorPathMarks)
+		secondPaths := schema.SensitivePaths(remarked, nil)
+
+		first := cty.NewPathSet(firstPaths...)
+		second := cty.NewPathSet(secondPaths...)
+		if !first.Equal(second) {
+			t.Fatalf("SensitivePaths not stable across mark/unmark round trip\nfirst:  %#v\nsecond: %#v", first, second)
+		}
+	})
+}
