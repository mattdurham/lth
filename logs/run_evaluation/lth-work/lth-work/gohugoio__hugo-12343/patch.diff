+// Issue 12342: date-based permalink pattern with hash in slug.
+func TestHashSignInDateBasedPermalink(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['section','rss','sitemap','taxonomy']
+[permalinks]
+posts = '/posts/:year/:month/:slug/'
+-- layouts/_default/single.html --
+{{ .RelPermalink }}
+-- content/posts/hash-in-title.md --
+---
+title: 'Newsletter #4'
+slug: 'newsletter-#4'
+date: 2024-04-04T12:27:52-07:00
+---
+Foo
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileExists("public/posts/2024/04/newsletter-#4/index.html", true)
+	b.AssertFileContent("public/posts/2024/04/newsletter-#4/index.html", "/posts/2024/04/newsletter-%234/")
+}
