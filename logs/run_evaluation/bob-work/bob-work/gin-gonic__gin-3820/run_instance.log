+// TestFormMultipartBindingOptionalFilePtr verifies that a *multipart.FileHeader field
+// without binding:"required" stays nil (no error) when no file is uploaded.
+func TestFormMultipartBindingOptionalFilePtr(t *testing.T) {
+	var s struct {
+		Name  string                `form:"name" binding:"required"`
+		Email string                `form:"email" binding:"required"`
+		File  *multipart.FileHeader `form:"file"`
+	}
+
+	req := createRequestMultipartFields(t, map[string]string{
+		"name":  "foo",
+		"email": "foo@example.com",
+	})
+	err := FormMultipart.Bind(req, &s)
+	require.NoError(t, err)
+	assert.Equal(t, "foo", s.Name)
+	assert.Equal(t, "foo@example.com", s.Email)
+	assert.Nil(t, s.File)
+}
+
+// TestFormMultipartBindingOptionalFileStruct verifies that a multipart.FileHeader field
+// without binding:"required" stays zero (no error) when no file is uploaded.
+func TestFormMultipartBindingOptionalFileStruct(t *testing.T) {
+	var s struct {
+		Name  string               `form:"name" binding:"required"`
+		Email string               `form:"email" binding:"required"`
+		File  multipart.FileHeader `form:"file"`
+	}
+
+	req := createRequestMultipartFields(t, map[string]string{
+		"name":  "foo",
+		"email": "foo@example.com",
+	})
+	err := FormMultipart.Bind(req, &s)
+	require.NoError(t, err)
+	assert.Equal(t, "foo", s.Name)
+	assert.Empty(t, s.File.Filename)
+	assert.Zero(t, s.File.Size)
+}
+
+// TestFormMultipartBindingEmptyFilename verifies that sending a file field with filename=""
+// (as browsers do for unselected file inputs) leaves *multipart.FileHeader nil.
+func TestFormMultipartBindingEmptyFilename(t *testing.T) {
+	var s struct {
+		Name string                `form:"name"`
+		File *multipart.FileHeader `form:"file"`
+	}
+
+	// Craft a multipart body that includes a file part with empty filename — this
+	// is what browsers send when a file <input> is submitted without selecting a file.
+	var body bytes.Buffer
+	mw := multipart.NewWriter(&body)
+	require.NoError(t, mw.WriteField("name", "bar"))
+	// CreateFormFile writes filename in Content-Disposition; we want filename=""
+	h := make(textproto.MIMEHeader)
+	h.Set("Content-Disposition", `form-data; name="file"; filename=""`)
+	h.Set("Content-Type", "application/octet-stream")
+	_, err := mw.CreatePart(h)
+	require.NoError(t, err)
+	require.NoError(t, mw.Close())
+
+	req, err := http.NewRequest(http.MethodPost, "/", &body)
+	require.NoError(t, err)
+	req.Header.Set("Content-Type", MIMEMultipartPOSTForm+"; boundary="+mw.Boundary())
+
+	err = FormMultipart.Bind(req, &s)
+	require.NoError(t, err)
+	assert.Equal(t, "bar", s.Name)
+	assert.Nil(t, s.File)
+}
+
 type testFile struct {
 	Fieldname string
 	Filename  string
 	Content   []byte
 }
 
+// createRequestMultipartFields creates a multipart POST request with plain form fields only.
+func createRequestMultipartFields(t *testing.T, fields map[string]string) *http.Request {
+	var body bytes.Buffer
+	mw := multipart.NewWriter(&body)
+	for k, v := range fields {
+		require.NoError(t, mw.WriteField(k, v))
+	}
+	require.NoError(t, mw.Close())
+	req, err := http.NewRequest(http.MethodPost, "/", &body)
+	require.NoError(t, err)
+	req.Header.Set("Content-Type", MIMEMultipartPOSTForm+"; boundary="+mw.Boundary())
+	return req
+}
