diff --git a/internal/config/expand.go b/internal/config/expand.go
new file mode 100644
index 0000000..6c4b1b9
--- /dev/null
+++ b/internal/config/expand.go
@@ -0,0 +1,91 @@
+// NOTE: Any changes to this file must be reflected in the corresponding SPECS.md or NOTES.md.
+
+package config
+
+import (
+	"fmt"
+	"os"
+	"regexp"
+	"strings"
+)
+
+// fileRefPattern matches {file.<path>} placeholders in config string values.
+// The path is captured in group 1.
+var fileRefPattern = regexp.MustCompile(`\{file\.([^}]+)\}`)
+
+// expandFileRefsInString replaces all {file.<path>} placeholders in s with the
+// contents of the referenced file. Trailing \r and \n characters are stripped
+// from each file's content before substitution. Returns an error if any
+// referenced file cannot be read.
+func expandFileRefsInString(s string) (string, error) {
+	var expandErr error
+	result := fileRefPattern.ReplaceAllStringFunc(s, func(match string) string {
+		if expandErr != nil {
+			return match
+		}
+		sub := fileRefPattern.FindStringSubmatch(match)
+		if len(sub) < 2 {
+			return match
+		}
+		path := sub[1]
+		data, err := os.ReadFile(path)
+		if err != nil {
+			expandErr = fmt.Errorf("read file ref %q: %w", path, err)
+			return match
+		}
+		return strings.TrimRight(string(data), "\r\n")
+	})
+	if expandErr != nil {
+		return "", expandErr
+	}
+	return result, nil
+}
+
+// expandFileRefs walks all string fields in cfg and expands any {file.<path>}
+// placeholders. It must be called before applyDefaults so that file-referenced
+// values are not mistaken for zero-value (empty) fields.
+func expandFileRefs(cfg *Config) error {
+	var err error
+
+	if cfg.LLM.APIKey, err = expandFileRefsInString(cfg.LLM.APIKey); err != nil {
+		return fmt.Errorf("LLM.APIKey: %w", err)
+	}
+	if cfg.LLM.BaseURL, err = expandFileRefsInString(cfg.LLM.BaseURL); err != nil {
+		return fmt.Errorf("LLM.BaseURL: %w", err)
+	}
+	if cfg.LLM.Provider, err = expandFileRefsInString(cfg.LLM.Provider); err != nil {
+		return fmt.Errorf("LLM.Provider: %w", err)
+	}
+	if cfg.LLM.Model, err = expandFileRefsInString(cfg.LLM.Model); err != nil {
+		return fmt.Errorf("LLM.Model: %w", err)
+	}
+
+	if cfg.Embedding.BaseURL, err = expandFileRefsInString(cfg.Embedding.BaseURL); err != nil {
+		return fmt.Errorf("Embedding.BaseURL: %w", err)
+	}
+	if cfg.Embedding.Provider, err = expandFileRefsInString(cfg.Embedding.Provider); err != nil {
+		return fmt.Errorf("Embedding.Provider: %w", err)
+	}
+	if cfg.Embedding.Model, err = expandFileRefsInString(cfg.Embedding.Model); err != nil {
+		return fmt.Errorf("Embedding.Model: %w", err)
+	}
+	if cfg.Embedding.DockerImage, err = expandFileRefsInString(cfg.Embedding.DockerImage); err != nil {
+		return fmt.Errorf("Embedding.DockerImage: %w", err)
+	}
+
+	if cfg.DB.Path, err = expandFileRefsInString(cfg.DB.Path); err != nil {
+		return fmt.Errorf("DB.Path: %w", err)
+	}
+
+	if cfg.Watcher.StateFile, err = expandFileRefsInString(cfg.Watcher.StateFile); err != nil {
+		return fmt.Errorf("Watcher.StateFile: %w", err)
+	}
+
+	for i, p := range cfg.Watcher.Paths {
+		if cfg.Watcher.Paths[i], err = expandFileRefsInString(p); err != nil {
+			return fmt.Errorf("Watcher.Paths[%d]: %w", i, err)
+		}
+	}
+
+	return nil
+}
