+package render
+
+import (
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestRenderReaderNilHeadersWithContentLength(t *testing.T) {
+	w := httptest.NewRecorder()
+	r := Reader{
+		ContentType:   "text/html",
+		ContentLength: 5,
+		Reader:        strings.NewReader("hello"),
+		Headers:       nil,
+	}
+	if err := r.Render(w); err != nil {
+		t.Fatalf("Render returned error: %v", err)
+	}
+	if got := w.Header().Get("Content-Length"); got != "5" {
+		t.Errorf("expected Content-Length=5, got %q", got)
+	}
+	if got := w.Body.String(); got != "hello" {
+		t.Errorf("expected body %q, got %q", "hello", got)
+	}
+}
+
+func TestRenderReaderNonNilHeadersPreserved(t *testing.T) {
+	w := httptest.NewRecorder()
+	r := Reader{
+		ContentType:   "text/plain",
+		ContentLength: 3,
+		Reader:        strings.NewReader("abc"),
+		Headers:       map[string]string{"X-Custom": "value"},
+	}
+	if err := r.Render(w); err != nil {
+		t.Fatalf("Render returned error: %v", err)
+	}
+	if got := w.Header().Get("X-Custom"); got != "value" {
+		t.Errorf("expected X-Custom=value, got %q", got)
+	}
+	if got := w.Header().Get("Content-Length"); got != "3" {
+		t.Errorf("expected Content-Length=3, got %q", got)
+	}
+}
+
+func TestRenderReaderNilHeadersNegativeContentLength(t *testing.T) {
+	w := httptest.NewRecorder()
+	r := Reader{
+		ContentType:   "text/html",
+		ContentLength: -1,
+		Reader:        strings.NewReader("streamed"),
+		Headers:       nil,
+	}
+	if err := r.Render(w); err != nil {
+		t.Fatalf("Render returned error: %v", err)
+	}
+	if got := w.Header().Get("Content-Length"); got != "" {
+		t.Errorf("expected no Content-Length header, got %q", got)
+	}
+}