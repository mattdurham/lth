+// TestPermalinkHashInSlug verifies that a '#' character in a page slug is
+// percent-encoded in the generated RelPermalink so the URL is not truncated
+// at the fragment separator. Regression test for issue #12169.
+func TestPermalinkHashInSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['rss','sitemap','taxonomy','term']
+[permalinks]
+posts = '/posts/:year/:month/:slug/'
+-- layouts/_default/single.html --
+RelPermalink: {{ .RelPermalink }}
+-- content/posts/newsletter-4.md --
+---
+title: 'Newsletter #4'
+slug: 'newsletter-#4'
+date: 2024-04-04T12:27:52-07:00
+---
+Foo
+`
+
+	b := hugolib.Test(t, files)
+
+	// The file is published with a literal '#' in the directory name (valid on most
+	// file systems), but RelPermalink must percent-encode '#' as '%23' so the URL is
+	// not truncated at the fragment separator.
+	b.AssertFileContent("public/posts/2024/04/newsletter-#4/index.html", "RelPermalink: /posts/2024/04/newsletter-%234/")
+}
+
 func TestPermalinksNestedSections(t *testing.T) {
 	t.Parallel()
