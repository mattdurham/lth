+func TestPathEscape(t *testing.T) {
+	c := qt.New(t)
+	// '#' in a path segment must be percent-encoded so it is not misinterpreted
+	// as a URL fragment separator.
+	c.Assert(PathEscape("/posts/2024/04/newsletter-#4/"), qt.Equals, "/posts/2024/04/newsletter-%234/")
+	c.Assert(PathEscape("/posts/newsletter-#4/index.html"), qt.Equals, "/posts/newsletter-%234/index.html")
+	// Paths without '#' should be unchanged.
+	c.Assert(PathEscape("/posts/2024/04/hello-world/"), qt.Equals, "/posts/2024/04/hello-world/")
+	// Unicode letters should still be escaped.
+	c.Assert(PathEscape("/posts/трям/"), qt.Equals, "/posts/%D1%82%D1%80%D1%8F%D0%BC/")
+}
